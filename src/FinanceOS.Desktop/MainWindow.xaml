<Window x:Class="FinanceOS.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FINANCE OS" Width="1100" Height="740" MinWidth="720" MinHeight="540"
 WindowStartupLocation="CenterScreen" Loaded="OnLoaded">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <Grid Margin="{StaticResource PagePadding}">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <StackPanel>
    <TextBlock Text="FINANCE OS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
    <TextBlock Text="A calm place for focused work." FontSize="32" FontWeight="SemiBold" Margin="0,18,0,12" />
    <TextBlock Text="Your private, offline workspace for finance operations." Foreground="{DynamicResource MutedBrush}" />
   </StackPanel>
   <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
     BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="28" Margin="0,32,0,24">
    <StackPanel>
     <TextBlock Text="Workspace foundation" FontSize="22" FontWeight="SemiBold" />
     <TextBlock x:Name="StorageText" Text="Opening local storage…" Margin="0,16,0,12" AutomationProperties.LiveSetting="Polite" />
     <TextBlock Text="Data stays in your Windows user profile. No account or network connection is required." Foreground="{DynamicResource MutedBrush}" />
     <WrapPanel Margin="0,24,0,0">
      <Button x:Name="CheckStorageButton" Content="_Check local storage" Click="OnCheckStorage" IsEnabled="False" Margin="0,0,12,12" />
      <Button x:Name="TestNoticeButton" Content="Test _in-app notice" Click="OnTestNotice" Margin="0,0,0,12" />
     </WrapPanel>
     <TextBlock x:Name="NoticeText" Text="System notifications and scheduling arrive in M3. This app does not run after exit."
       Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
   </Border>
   <StackPanel Grid.Row="2">
    <TextBlock Text="What comes next" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Margin="0,12,0,0" Text="M1 · Design system, navigation, themes, language and workspace preferences."
      Foreground="{DynamicResource MutedBrush}" />
    <TextBlock Margin="0,8,0,0" Text="Task management, calendar, reminders and advanced workflows are planned modules and are not available in this foundation build."
      Foreground="{DynamicResource MutedBrush}" />
   </StackPanel>
  </Grid>
 </ScrollViewer>
</Window>
