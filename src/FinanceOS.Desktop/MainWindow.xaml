<Window x:Class="FinanceOS.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FINANCE OS" Width="1180" Height="760" MinWidth="720" MinHeight="540"
 WindowStartupLocation="CenterScreen" Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
 <DockPanel LastChildFill="True">
  <Border DockPanel.Dock="Left" Width="218" Padding="18,26" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
   <DockPanel LastChildFill="False">
    <TextBlock DockPanel.Dock="Top" Text="FINANCE OS" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,30" />
    <StackPanel DockPanel.Dock="Top">
     <TextBlock x:Name="NavigateLabel" Text="WORKSPACE" Style="{StaticResource EyebrowText}" Margin="8,0,0,8" />
     <Button x:Name="OverviewButton" Content="_Overview" Tag="Overview" Click="OnNavigate" Style="{StaticResource NavButton}" />
     <Button x:Name="SettingsButton" Content="_Settings" Tag="Settings" Click="OnNavigate" Style="{StaticResource NavButton}" />
     <TextBlock x:Name="ComingSoonLabel" Text="COMING LATER" Style="{StaticResource EyebrowText}" Margin="8,26,0,8" />
     <Button x:Name="MyDayButton" Content="_My Day" Tag="MyDay" Click="OnNavigate" Style="{StaticResource NavButton}" />
     <Button x:Name="TasksButton" Content="_Tasks" Tag="Tasks" Click="OnNavigate" Style="{StaticResource NavButton}" />
     <Button x:Name="ArchiveButton" Content="_Archive" Tag="Archive" Click="OnNavigate" Style="{StaticResource NavButton}" />
     <Button x:Name="TrashButton" Content="T_rash" Tag="Trash" Click="OnNavigate" Style="{StaticResource NavButton}" />
     <Button x:Name="CalendarButton" Content="Calendar · M3" IsEnabled="False" Style="{StaticResource NavButton}" />
     <Button x:Name="RemindersButton" Content="Reminders · M3" IsEnabled="False" Style="{StaticResource NavButton}" />
     <Button x:Name="WorkflowsButton" Content="Workflows · M4" IsEnabled="False" Style="{StaticResource NavButton}" />
     <Button x:Name="ProjectsButton" Content="Projects · M4" IsEnabled="False" Style="{StaticResource NavButton}" />
     <Button x:Name="AnalyticsButton" Content="Analytics · M5" IsEnabled="False" Style="{StaticResource NavButton}" />
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,16">
    <DockPanel LastChildFill="False">
     <TextBlock x:Name="PageTitle" Text="Overview" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" />
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
      <TextBox x:Name="QuickTitleBox" Width="170" Height="40" VerticalContentAlignment="Center" Margin="0,0,8,0"
       ToolTip="Quick capture: type a title and press Enter" KeyDown="OnQuickTitleKeyDown" AutomationProperties.Name="Quick task title" />
      <Button x:Name="QuickAddButton" IsEnabled="False" Content="_Add task" Click="OnQuickAdd" Margin="0,0,8,0" />
      <Button x:Name="SwitchModeButton" Content="Simple mode" Click="OnSwitchMode" Margin="0,0,8,0" AutomationProperties.HelpText="Switches presentation only; data is shared" />
      <Button x:Name="SwitchThemeButton" Content="Dark theme" Click="OnSwitchTheme" Margin="0,0,8,0" />
      <Button x:Name="SwitchLanguageButton" Content="RO" Click="OnSwitchLanguage" />
     </StackPanel>
    </DockPanel>
   </Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,26" MaxWidth="860" HorizontalAlignment="Left">
     <Border x:Name="OnboardingPanel" Style="{StaticResource Card}" Margin="0,0,0,20">
      <StackPanel>
       <TextBlock x:Name="WelcomeTitle" Text="Welcome to your private workspace" Style="{StaticResource SectionTitle}" />
       <TextBlock x:Name="WelcomeBody" Text="Your settings are saved on this device. Tasks and planning arrive in the next milestones." Style="{StaticResource MutedText}" Margin="0,10,0,16" />
       <Button x:Name="DismissOnboardingButton" Content="_Get started" Click="OnDismissOnboarding" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
      </StackPanel>
     </Border>
     <StackPanel x:Name="OverviewPanel">
      <TextBlock x:Name="OverviewHeading" Text="A clear start to the day." FontSize="30" FontWeight="SemiBold" />
      <TextBlock x:Name="OverviewDescription" Text="Your offline workspace is ready. Tasks, calendars and reminders will arrive in upcoming milestones." Style="{StaticResource MutedText}" Margin="0,8,0,22" />
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock x:Name="StorageHeading" Text="Local storage" Style="{StaticResource SectionTitle}" />
       <TextBlock x:Name="StorageText" Text="Opening local storage…" Margin="0,14,0,12" AutomationProperties.LiveSetting="Polite" />
       <TextBlock x:Name="PrivacyText" Text="Data stays in your Windows user profile." Style="{StaticResource MutedText}" />
       <WrapPanel Margin="0,22,0,0">
        <Button x:Name="CheckStorageButton" Content="_Check local storage" Click="OnCheckStorage" IsEnabled="False" Margin="0,0,10,10" />
        <Button x:Name="TestNoticeButton" Content="Test _in-app notice" Click="OnTestNotice" Margin="0,0,0,10" />
       </WrapPanel>
       <TextBlock x:Name="NoticeText" Text="System notifications and scheduling arrive in M3. This app does not run after exit." Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="TaskPanel" Visibility="Collapsed">
      <TextBlock x:Name="TaskHeading" Text="Tasks" FontSize="30" FontWeight="SemiBold" />
      <TextBlock x:Name="TaskSummaryText" Style="{StaticResource MutedText}" Margin="0,8,0,16" />
      <WrapPanel Margin="0,0,0,12">
       <TextBox x:Name="SearchBox" Width="260" Height="40" VerticalContentAlignment="Center" Margin="0,0,12,8"
        TextChanged="OnSearchChanged" AutomationProperties.Name="Search tasks" />
       <ComboBox x:Name="TaskFilterBox" Width="140" Height="40" SelectedIndex="0" SelectionChanged="OnFilterChanged" Margin="0,0,0,8">
        <ComboBoxItem Content="All" /><ComboBoxItem Content="Open" /><ComboBoxItem Content="Done" />
       </ComboBox>
      </WrapPanel>
      <DataGrid x:Name="TaskGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
       MinHeight="240" MaxHeight="390" SelectionChanged="OnTaskSelectionChanged" Background="{DynamicResource SurfaceBrush}"
       Foreground="{DynamicResource TextBrush}" RowBackground="{DynamicResource SurfaceBrush}"
       AlternatingRowBackground="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Task" Binding="{Binding Title}" Width="3*" />
        <DataGridTextColumn Header="Due" Binding="{Binding DueDate}" Width="*" />
        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="*" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
       </DataGrid.Columns>
      </DataGrid>
      <WrapPanel Margin="0,12,0,20">
       <Button x:Name="CompleteTaskButton" Content="_Complete" Click="OnCompleteTask" Margin="0,0,8,8" IsEnabled="False" />
       <Button x:Name="ReopenTaskButton" Content="_Reopen" Click="OnReopenTask" Margin="0,0,8,8" IsEnabled="False" />
       <Button x:Name="ArchiveTaskButton" Content="_Archive" Click="OnArchiveTask" Margin="0,0,8,8" IsEnabled="False" />
       <Button x:Name="DeleteTaskButton" Content="Move to _trash…" Click="OnDeleteTask" Margin="0,0,8,8" IsEnabled="False" />
      </WrapPanel>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock x:Name="EditorHeading" Text="New task" Style="{StaticResource SectionTitle}" />
       <TextBox x:Name="TaskTitleBox" Height="38" Margin="0,14,0,8" VerticalContentAlignment="Center"
        AutomationProperties.Name="Task title" MaxLength="300" />
       <StackPanel x:Name="AdvancedFieldsPanel">
        <TextBox x:Name="TaskNotesBox" Height="68" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8"
         AutomationProperties.Name="Task notes" MaxLength="10000" />
        <WrapPanel>
         <DatePicker x:Name="TaskDuePicker" Width="160" Margin="0,0,12,8" AutomationProperties.Name="Due date" />
         <ComboBox x:Name="TaskPriorityBox" Width="130" Height="38" SelectedIndex="1" AutomationProperties.Name="Priority">
          <ComboBoxItem Content="Low" /><ComboBoxItem Content="Normal" /><ComboBoxItem Content="High" /><ComboBoxItem Content="Urgent" />
         </ComboBox>
        </WrapPanel>
       </StackPanel>
       <WrapPanel Margin="0,12,0,0">
        <Button x:Name="SaveTaskButton" IsEnabled="False" Content="_Save task" Click="OnSaveTask" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
        <Button x:Name="CancelEditButton" Content="Cancel edit" Click="OnCancelEdit" />
       </WrapPanel>
      </StackPanel></Border>
      <TextBlock x:Name="TaskErrorText" Style="{StaticResource MutedText}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
     </StackPanel>
     <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
      <TextBlock x:Name="SettingsHeading" Text="Make the workspace yours." FontSize="30" FontWeight="SemiBold" />
      <TextBlock x:Name="SettingsDescription" Text="These choices persist locally and apply to the same workspace." Style="{StaticResource MutedText}" Margin="0,8,0,22" />
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock x:Name="PreferencesHeading" Text="Preferences" Style="{StaticResource SectionTitle}" />
       <TextBlock x:Name="CurrentPreferencesText" Margin="0,16,0,16" AutomationProperties.LiveSetting="Polite" />
       <TextBlock x:Name="ModeDescription" Text="Simple and Advanced share the same data. Advanced features appear as they are built." Style="{StaticResource MutedText}" />
       <TextBlock x:Name="UnavailableDescription" Text="Appearance, language and mode can be changed from the header." Style="{StaticResource MutedText}" Margin="0,12,0,0" />
      </StackPanel></Border>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
